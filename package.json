{
  "name": "bon-arena",
  "version": "0.4.0",
  "description": "Run multiple coding agents (Claude Code, Codex CLI, Antigravity CLI, ...) on the same task in isolated git worktrees and compare the results.",
  "type": "module",
  "license": "MIT",
  "author": "Shuichi Suzuki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksuzuki/bon-arena.git"
  },
  "homepage": "https://github.com/jacksuzuki/bon-arena#readme",
  "bugs": {
    "url": "https://github.com/jacksuzuki/bon-arena/issues"
  },
  "bin": {
    "arena": "dist/arena.js"
  },
  "files": [
    "dist",
    ".claude/skills",
    "README.md",
    "docs/README.ja.md",
    "docs/README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/mark-executable.mjs",
    "prepare": "npm run build",
    "dev": "node src/arena.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run test:package"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
